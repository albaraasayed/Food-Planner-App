<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashScreen">

    <fragment
        android:id="@+id/splashScreen"
        android:name="com.example.foodplannerapp.ui.SplashScreen"
        android:label="Splash">
        <action
            android:id="@+id/action_splashScreen_to_onboarding"
            app:destination="@id/onboarding" />
    </fragment>
    <fragment
        android:id="@+id/onboarding"
        android:name="com.example.foodplannerapp.ui.Onboarding"
        android:label="Onboarding">
        <action
            android:id="@+id/action_onboarding_to_authScreen"
            app:destination="@id/authScreen" />
    </fragment>

    <fragment
        android:id="@+id/authScreen"
        android:name="com.example.foodplannerapp.ui.AuthScreen"
        android:label="AuthScreen">
        <action
            android:id="@+id/action_authScreen_to_homeScreen"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.foodplannerapp.ui.home.HomeScreen"
        android:label="Home" />


</navigation>
